---
import ZenkaiWindow from './ZenkaiWindow.tsx';
import { downloadHref, fetchLatestRelease } from '../lib/release';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).hero;
const release = await fetchLatestRelease();
---

<section class="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="backdrop-layer backdrop-light"></div>
    <div class="backdrop-layer backdrop-dark"></div>
    <div class="hero-scrim"></div>
  </div>

  <div class="container-wide hero-inner">
    <div class="hero-copy">
      <div class="hero-kicker">
        <span class="hero-kicker-dot" aria-hidden="true"></span>
        {d.kicker}
      </div>
      <h1 class="hero-title" set:html={d.title} />
      <p class="hero-sub" set:html={d.sub} />
      <div class="hero-ctas">
        <a class="btn btn-primary" href={downloadHref(release, 'windows')} data-latest-download="windows">
          {d.ctaDownload}
        </a>
        <a class="btn btn-ghost" href="#grid">{d.ctaTry}</a>
      </div>
    </div>

    <ZenkaiWindow client:load lang={lang} />
  </div>
</section>

<script>
  import { downloadHref, fetchLatestRelease } from '../lib/release';

  // Keep the hero CTA pointing at the newest installer, even before the next deploy.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-latest-download="windows"]');
  const latest = fetchLatestRelease();

  latest.then((release) => {
    if (!release.tag) return;
    links.forEach((link) => {
      link.href = downloadHref(release, 'windows');
    });
  });

  // If the build-time lookup failed and the visitor clicks before the browser lookup
  // resolves, the href still points at the releases page: wait for the lookup instead.
  links.forEach((link) => {
    link.addEventListener('click', async (event) => {
      if (link.href.includes('/releases/download/')) return;
      event.preventDefault();
      const release = await latest;
      window.location.href = downloadHref(release, 'windows');
    });
  });
</script>

<style is:global>
  .hero {
    position: relative;
    padding: 5.5rem 0 5.5rem;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .backdrop-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 32%;
    transition: opacity var(--t-bg), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .backdrop-light {
    background-image: url('/art/hero-day.webp');
    opacity: 1;
    transform: scale(1);
  }

  .backdrop-dark {
    background-image: url('/art/hero-night.webp');
    background-position: center 22%;
    opacity: 0;
    transform: scale(1.03);
  }

  [data-theme='dark'] .backdrop-light {
    opacity: 0;
    transform: scale(1.02);
  }

  [data-theme='dark'] .backdrop-dark {
    opacity: 1;
    transform: scale(1);
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--hero-scrim-top) 0%,
      var(--hero-scrim-mid) 34%,
      rgba(0, 0, 0, 0) 54%,
      var(--hero-scrim-bottom) 96%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.85rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-elevated);
    border: 1px solid var(--hairline-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-secondary);
    margin-bottom: 1.1rem;
    backdrop-filter: blur(8px);
  }

  .hero-kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent-primary);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5.2vw, 4.4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--hero-text);
    margin-bottom: 1.1rem;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent-primary);
  }

  .hero-sub {
    font-size: clamp(0.98rem, 1.4vw, 1.12rem);
    color: var(--hero-text-muted);
    max-width: 58ch;
    margin: 0 auto 1.75rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  /* ==========================================================================
     Spacious 3-Pane Zenkai Window (Sharp corners, faithful to themes.png)
     ========================================================================== */
  .app-window {
    width: 100%;
    background: var(--win-bg);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--win-shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: background-color var(--t-theme), border-color var(--t-theme);
  }

  .win-titlebar {
    height: 35px;
    padding: 0 12px;
    background: var(--win-chrome);
    border-bottom: 1px solid var(--win-grid-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.76rem;
    color: var(--ink-muted);
  }

  .win-title-left {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--ink-primary);
  }

  .win-title-center {
    font-size: 0.73rem;
    color: var(--ink-muted);
  }

  .win-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-faint);
    font-size: 0.78rem;
  }

  .win-body {
    display: grid;
    grid-template-columns: 205px minmax(0, 1fr) 268px;
    min-height: 492px;
  }

  /* LEFT: Full-Height Spaces Sidebar */
  .win-sidebar {
    background: var(--win-sidebar);
    border-right: 1px solid var(--win-grid-line);
    padding: 9px 8px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 0.74rem;
  }

  .sb-actions {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--win-grid-line);
  }

  .sb-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 7px;
    border-radius: var(--radius-sm);
    color: var(--ink-secondary);
    font-weight: 500;
  }

  .sb-action-row kbd {
    font-size: 0.65rem;
    color: var(--ink-faint);
  }

  .space-card {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--win-grid-line);
  }

  .space-head {
    padding: 4px 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.69rem;
    font-weight: 600;
    color: #ffffff;
  }

  .space-files {
    padding: 3px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .space-file {
    padding: 4px 6px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 1px;
    color: var(--ink-primary);
    font-size: 0.7rem;
    line-height: 1.25;
  }

  .space-file span {
    font-size: 0.62rem;
    color: var(--ink-muted);
  }

  .space-file.is-active {
    background: rgba(0, 0, 0, 0.08);
    font-weight: 600;
  }

  [data-theme='dark'] .space-file.is-active {
    background: rgba(255, 255, 255, 0.1);
  }

  .space-file.is-active span {
    color: var(--ink-secondary);
  }

  .sp-teal { background: var(--sp-teal-bg); }
  .sp-teal .space-head { background: var(--sp-teal-hd); }
  .sp-blue { background: var(--sp-blue-bg); }
  .sp-blue .space-head { background: var(--sp-blue-hd); }
  .sp-green { background: var(--sp-green-bg); }
  .sp-green .space-head { background: var(--sp-green-hd); }
  .sp-rust { background: var(--sp-rust-bg); }
  .sp-rust .space-head { background: var(--sp-rust-hd); }
  .sp-purple { background: var(--sp-purple-bg); }
  .sp-purple .space-head { background: var(--sp-purple-hd); }

  /* CENTER: Toolbar + Formula Bar (STRICTLY above sheet!) + Grid + Tabs */
  .win-center {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--win-bg);
  }

  .win-toolbar {
    height: 31px;
    padding: 0 10px;
    background: var(--win-toolbar);
    border-bottom: 1px solid var(--win-grid-line);
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 0.72rem;
    color: var(--ink-muted);
    overflow: hidden;
  }

  .tb-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .tb-sep {
    width: 1px;
    height: 14px;
    background: var(--win-grid-line);
  }

  .tb-btn {
    font-weight: 600;
  }

  .win-formula-bar {
    height: 30px;
    display: flex;
    align-items: center;
    background: var(--win-bg);
    border-bottom: 1px solid var(--win-grid-line);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .fx-namebox {
    width: 56px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--win-grid-line);
    color: var(--ink-primary);
    font-weight: 600;
    flex-shrink: 0;
  }

  .fx-icon {
    padding: 0 10px;
    color: var(--ink-faint);
    font-style: italic;
    font-family: var(--font-serif);
    font-size: 0.92rem;
    flex-shrink: 0;
  }

  .fx-input {
    flex: 1;
    color: var(--ink-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 10px;
  }

  .grid-wrap {
    flex: 1;
    overflow-x: auto;
  }

  .sheet-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.75rem;
  }

  .sheet-table th,
  .sheet-table td {
    border-right: 1px solid var(--win-grid-line);
    border-bottom: 1px solid var(--win-grid-line);
    padding: 0 8px;
    height: 27px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sheet-table thead th {
    background: var(--win-grid-header);
    color: var(--ink-faint);
    font-weight: 500;
    font-size: 0.7rem;
    text-align: center;
    height: 24px;
  }

  .sheet-table col.col-rn { width: 36px; }
  .sheet-table col.col-a { width: 68px; }
  .sheet-table col.col-b { width: 175px; }
  .sheet-table col.col-c { width: 82px; }
  .sheet-table col.col-num { width: 104px; }

  .rn {
    background: var(--win-grid-header);
    color: var(--ink-faint);
    text-align: center !important;
    padding: 0 4px !important;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    user-select: none;
  }

  .row-caption td:not(.rn) {
    font-style: italic;
    color: var(--ink-muted);
    font-size: 0.72rem;
  }

  .row-tbl-head td:not(.rn) {
    background: var(--win-tbl-head-bg);
    color: var(--win-tbl-head-ink);
    font-weight: 600;
    font-size: 0.74rem;
  }

  .num {
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .is-editable {
    cursor: text;
  }

  .is-editable:hover {
    background: var(--win-row-hover);
  }

  .cell-editor {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--ink-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: right;
    outline: none;
  }

  .row-total td:not(.rn) {
    font-weight: 700;
    border-top: 1.5px solid var(--ink-faint);
    border-bottom: 2px double var(--ink-faint);
  }

  .cell-selected {
    background: var(--win-cell-selected-bg);
    box-shadow: inset 0 0 0 1.5px var(--win-cell-selected-border);
  }

  .cell-proposed {
    background: var(--win-proposal-bg);
    box-shadow: inset 0 0 0 1.5px var(--win-proposal-border);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .badge-check {
    display: inline-block;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    font-weight: 600;
    font-size: 0.7rem;
  }

  .badge-check.is-ok {
    background: var(--accent-primary-soft);
    color: var(--accent-primary);
  }

  .badge-check.is-warn {
    background: var(--accent-amber-soft);
    color: var(--accent-amber);
  }

  .win-tabs {
    height: 30px;
    padding: 0 10px;
    background: var(--win-chrome);
    border-top: 1px solid var(--win-grid-line);
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }

  .sheet-tab {
    padding: 4px 12px;
    border: none;
    background: transparent;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
    color: var(--ink-muted);
    font-size: 0.72rem;
  }

  .sheet-tab.is-active {
    background: var(--win-bg);
    color: var(--ink-primary);
    font-weight: 600;
    border: 1px solid var(--win-grid-line);
    border-bottom: none;
  }

  /* RIGHT: Full-Height Agent Panel */
  .win-agent {
    background: var(--win-panel-bg);
    border-left: 1px solid var(--win-grid-line);
    display: flex;
    flex-direction: column;
    font-size: 0.75rem;
  }

  .agent-head {
    height: 31px;
    padding: 0 12px;
    border-bottom: 1px solid var(--win-grid-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    color: var(--ink-primary);
    font-size: 0.72rem;
  }

  .agent-head span {
    font-weight: 400;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  .agent-body {
    flex: 1;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .agent-intro {
    font-size: 0.72rem;
    color: var(--ink-secondary);
    line-height: 1.5;
  }

  .agent-msg-user {
    align-self: flex-end;
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 7px 10px;
    border-radius: var(--radius-sm);
    color: var(--ink-primary);
    font-size: 0.72rem;
    line-height: 1.45;
    max-width: 92%;
  }

  .agent-proposal {
    background: var(--surface);
    border: 1px solid var(--win-proposal-border);
    border-radius: var(--radius-sm);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prop-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--accent-primary);
    font-weight: 600;
    text-transform: uppercase;
  }

  .prop-diff {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    padding: 6px 8px;
    border-radius: var(--radius-xs);
    background: var(--win-proposal-bg);
    color: var(--ink-primary);
  }

  .prop-actions {
    display: flex;
    gap: 6px;
  }

  .prop-btn {
    flex: 1;
    padding: 5px 8px;
    border-radius: var(--radius-xs);
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid var(--hairline-strong);
    background: var(--surface);
    color: var(--ink-secondary);
  }

  .prop-btn.is-approve {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
  }

  [data-theme='dark'] .prop-btn.is-approve {
    color: var(--btn-fg);
  }

  .agent-composer {
    margin: 0 10px 10px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .composer-placeholder {
    font-size: 0.72rem;
    color: var(--ink-faint);
  }

  .composer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  .composer-picks {
    display: flex;
    gap: 12px;
  }

  .composer-pick {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .composer-pick svg {
    width: 7px;
    height: 5px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .composer-send {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-xs);
    background: var(--btn-bg);
    color: var(--btn-fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
  }

  .win-statusbar {
    height: 26px;
    padding: 0 12px;
    background: var(--win-status-bg);
    border-top: 1px solid var(--win-grid-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  .status-group {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .status-pill {
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    background: var(--accent-primary-soft);
    color: var(--accent-primary);
    font-weight: 600;
  }

  @media (max-width: 1120px) {
    .win-body {
      grid-template-columns: 185px minmax(0, 1fr);
    }

    .win-agent {
      display: none;
    }
  }

  /* Mobile-only cells are hidden on larger screens */
  .app-window .zk-monly {
    display: none;
  }

  @media (max-width: 740px) {
    .win-body {
      grid-template-columns: 1fr;
    }

    .win-sidebar {
      display: none;
    }
  }

  /* Phones: keep only the columns that matter (name, debits, credits, closing) */
  @media (max-width: 600px) {
    .hero-kicker {
      font-size: 0.6rem;
      letter-spacing: 0;
      padding: 5px 9px;
      white-space: nowrap;
    }

    .app-window .zk-mhide {
      display: none;
    }

    .app-window td.zk-monly {
      display: table-cell;
    }

    .app-window span.zk-monly {
      display: inline;
    }

    .sheet-table {
      font-size: 0.68rem;
    }

    .sheet-table th,
    .sheet-table td {
      padding: 0 5px;
      height: 30px;
    }

    .sheet-table col.col-rn { width: 24px; }
    .sheet-table col.col-b { width: auto; }
    .sheet-table col.col-num { width: 26%; }

    .win-title-center {
      font-size: 0.66rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }

    .win-statusbar .status-group {
      gap: 10px;
      white-space: nowrap;
    }
  }
</style>
