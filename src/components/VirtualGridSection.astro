---
import VirtualGridDemo from './VirtualGridDemo.tsx';
---

<section id="grid" class="section-shell">
  <div class="container">
    <div class="section-header">
      <div class="section-heading-group">
        <p class="section-kicker">01 · Visible-Range Native Grid (Rust + GPUI)</p>
        <h2 class="section-title">
          Scrub a million rows and <em>16,384 columns</em> without stutter.
        </h2>
        <p class="section-lead">
          Zenkai draws only the visible cells from a visible-range cache while load, save, and
          IronCalc recalculations run off the UI thread. Drag the vertical or horizontal rails—or
          scroll fast with your wheel—across the full Excel grid bounds.
        </p>
      </div>
    </div>

    <VirtualGridDemo client:visible />
  </div>
</section>

<style is:global>
  .forge-shell {
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .forge-topbar {
    padding: 0.78rem 1.1rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .forge-hud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.73rem;
  }

  .hud-chip {
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
    background: var(--surface);
    border: 1px solid var(--hairline);
    color: var(--ink-secondary);
  }

  .hud-chip strong {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .forge-jumps {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
  }

  .forge-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px;
    background: var(--win-bg);
  }

  .forge-grid-viewport {
    overflow: hidden;
    cursor: grab;
    user-select: none;
  }

  .forge-grid-viewport:active {
    cursor: grabbing;
  }

  .forge-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .forge-table th,
  .forge-table td {
    border-right: 1px solid var(--win-grid-line);
    border-bottom: 1px solid var(--win-grid-line);
    height: 32px;
    padding: 0 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .forge-table thead th {
    background: var(--win-grid-header);
    color: var(--ink-muted);
    font-weight: 600;
    text-align: center;
    height: 28px;
  }

  .forge-table .f-rn {
    width: 82px;
    background: var(--win-grid-header);
    color: var(--ink-faint);
    text-align: right;
    padding-right: 10px;
    font-size: 0.72rem;
  }

  .forge-table td.is-formula {
    color: var(--accent-primary);
    font-weight: 500;
  }

  .v-rail {
    background: var(--bg-subtle);
    border-left: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 0;
  }

  .v-rail input[type='range'] {
    writing-mode: vertical-lr;
    direction: ltr;
    width: 18px;
    height: 244px;
    accent-color: var(--accent-primary);
    cursor: ns-resize;
  }

  .forge-bottombar {
    padding: 0.72rem 1.1rem;
    background: var(--bg-subtle);
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .forge-bottombar strong {
    color: var(--ink-primary);
  }

  .forge-bottombar input[type='range'] {
    width: 100%;
    accent-color: var(--accent-primary);
    cursor: ew-resize;
  }

  @media (max-width: 720px) {
    .forge-bottombar {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .forge-topbar {
      padding: 0.7rem;
    }

    .forge-hud .hud-secondary,
    .forge-hint {
      display: none;
    }

    .forge-table {
      font-size: 0.7rem;
    }

    .forge-table th,
    .forge-table td {
      padding: 0 6px;
    }

    .forge-table .f-rn {
      width: 62px;
      padding-right: 6px;
    }

    .forge-stage {
      grid-template-columns: minmax(0, 1fr) 34px;
    }

    .forge-bottombar {
      padding: 0.7rem;
      gap: 0.5rem;
    }
  }
</style>
