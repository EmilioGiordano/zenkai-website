---
import { PROVIDERS, ProviderIconSvg } from './ProviderBadge';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const d = dict.ai;

// Monthly revenue in $M. Jul vs Jun is +9.1%, matching the KPI.
const revenue = [0.62, 0.71, 0.68, 0.84, 0.92, 1.155, 1.26];
const chartMax = 1.3;
const ticks = [0, 0.6, 1.2].map((v) => ({
  y: (v / chartMax) * 100,
  label: v === 0 ? '$0' : `$${v.toLocaleString(dict.numLocale, { maximumFractionDigits: 1 })}M`,
}));
const bars = revenue.map((v) => (v / chartMax) * 100);
const spark = [42, 55, 48, 62, 58, 74, 88];
---

<section id="providers" class="section-shell providers-section">
  <div class="container">
    <div class="section-header">
      <div class="section-heading-group">
        <p class="section-kicker">{d.kicker}</p>
        <h2 class="section-title" set:html={d.title} />
        <p class="section-lead">{d.lead}</p>
      </div>
    </div>

    <div class="caps-grid" role="list">
      <article class="cap-card is-wide" role="listitem">
        <div class="cap-fig fig-report" aria-hidden="true">
          <div class="join-files">
            {d.report.files.map((file) => <span class="file-chip"><i class="file-dot"></i>{file}</span>)}
          </div>
          <svg class="flow flow-in" viewBox="0 0 64 94" aria-hidden="true">
            <defs>
              <linearGradient id="flow-base-in" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="64" y2="0">
                <stop offset="0" class="base-stop-start" />
                <stop offset="1" class="base-stop-end" />
              </linearGradient>
            </defs>
            <g class="flow-base" stroke="url(#flow-base-in)">
              <path d="M1 13 C38 13 28 47 63 47" />
              <path d="M1 47 H63" />
              <path d="M1 81 C38 81 28 47 63 47" />
            </g>
            <g class="flow-ports">
              <circle cx="1" cy="13" r="3.2" /><circle cx="1" cy="47" r="3.2" /><circle cx="1" cy="81" r="3.2" />
              <circle cx="63" cy="47" r="3.2" />
            </g>
          </svg>
          <div class="ai-core">
            <span>{d.report.aiLabel}</span>
          </div>
          <svg class="flow flow-out" viewBox="0 0 48 94" aria-hidden="true">
            <g class="flow-base flow-base-out">
              <path d="M1 47 H47" />
            </g>
            <g class="flow-ports">
              <circle cx="1" cy="47" r="3.2" /><circle cx="47" cy="47" r="3.2" />
            </g>
          </svg>
          <div class="rep-doc">
            <div class="rep-head">
              <strong>{d.report.heading}</strong>
              <span>{d.report.meta}</span>
            </div>
            {
              d.report.rows.map((row, i) => (
                <div class={`rep-row is-${row.kind}`} style={`--i:${i};`}>
                  <i class="rep-icon">{row.kind === 'up' ? '▲' : row.kind === 'down' ? '▼' : '!'}</i>
                  <span>{row.label}</span>
                  <b>{row.value}</b>
                </div>
              ))
            }
            <div class="rep-spark">
              {spark.map((h, i) => <span style={`--h:${h}%; --i:${i};`} />)}
            </div>
          </div>
        </div>
        <h3 class="cap-title">{d.report.title}</h3>
        <p class="cap-text">{d.report.text}</p>
      </article>

      <article class="cap-card" role="listitem">
        <div class="cap-fig fig-review" data-review>
          <div class="mini-sheet">
            {
              d.review.issues.map((issue) => (
                <div class="mini-row">
                  <span class="ref">{issue.ref}</span>
                  <span class="val">
                    <span class="v-pending">
                      {issue.old && <s>{issue.old}</s>}
                      <b class={issue.value.startsWith('#') ? 'is-error' : ''}>{issue.value}</b>
                    </span>
                    <span class="v-fixed"><b>{issue.fixed}</b></span>
                  </span>
                  <span class="tag">
                    <span class="v-pending">{issue.tag}</span>
                    <span class="v-fixed">{d.review.fixedTag}</span>
                  </span>
                </div>
              ))
            }
          </div>
          <div class="review-foot">
            <span class="v-pending">{d.review.fixes}</span>
            <span class="v-fixed" aria-live="polite">{d.review.applied}</span>
            <button
              type="button"
              class="review-pill"
              aria-pressed="false"
              data-review-toggle
              data-apply={d.review.approve}
              data-undo={d.review.undo}
            >
              {d.review.approve}
            </button>
          </div>
        </div>
        <h3 class="cap-title">{d.review.title}</h3>
        <p class="cap-text">{d.review.text}</p>
      </article>

      <article class="cap-card" role="listitem">
        <div class="cap-fig fig-dash" aria-hidden="true">
          <div class="kpis">
            {
              d.dash.kpis.map((kpi) => (
                <div class="kpi">
                  <span>{kpi.label}</span>
                  <strong>{kpi.value}</strong>
                  <em>{kpi.delta}</em>
                </div>
              ))
            }
          </div>
          <div class="chart">
            <div class="chart-y">
              {ticks.map((tick) => <span style={`--y:${tick.y}%;`}>{tick.label}</span>)}
            </div>
            <div class="chart-plot">
              {ticks.slice(1).map((tick) => <i class="chart-grid" style={`--y:${tick.y}%;`} />)}
              <div class="bars">
                {bars.map((h, i) => (
                  <span class={`bar${i === bars.length - 1 ? ' is-last' : ''}`} style={`--h:${h}%; --i:${i};`} />
                ))}
              </div>
            </div>
            <div class="chart-x">
              {d.dash.months.map((m) => <span>{m}</span>)}
            </div>
          </div>
        </div>
        <h3 class="cap-title">{d.dash.title}</h3>
        <p class="cap-text">{d.dash.text}</p>
      </article>

      <article class="cap-card is-wide" role="listitem">
        <div class="cap-fig fig-formula" aria-hidden="true">
          <div class="fx-block is-old">
            <span class="fx-label">{d.formula.beforeLabel}</span>
            <div class="fx-bar"><span class="fx">fx</span><code>{d.formula.before}</code></div>
          </div>
          <svg class="fx-arrow" viewBox="0 0 16 16"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" /></svg>
          <div class="fx-block is-new">
            <span class="fx-label">{d.formula.afterLabel}</span>
            <div class="fx-bar"><span class="fx">fx</span><code>{d.formula.after}</code></div>
          </div>
          <div class="fx-checks">
            <span class="fx-check is-status">{d.formula.status}</span>
            {d.formula.checks.map((check) => <span class="fx-check">{check}</span>)}
          </div>
        </div>
        <h3 class="cap-title">{d.formula.title}</h3>
        <p class="cap-text">{d.formula.text}</p>
      </article>
    </div>

    <div class="providers-block">
      <p class="providers-label">{d.providersLabel}</p>
      <div class="providers-grid" role="list">
        {
          PROVIDERS.map((agent) => (
            <article
              class="provider-tile"
              role="listitem"
              style={`--brand-accent: ${agent.accent}; --brand-soft: ${agent.accentSoft}; --brand-border: ${agent.badgeBorder};`}
            >
              <div class="provider-brand-strip" aria-hidden="true" />
              <div class="provider-emblem" aria-hidden="true">
                <ProviderIconSvg brand={agent.id} size={36} />
              </div>
              <div class="provider-title-wrap">
                <span class="provider-vendor">{agent.vendor}</span>
                <h3 class="provider-name">{agent.name}</h3>
              </div>
              <code class="provider-cmd"><span aria-hidden="true">$</span> {agent.cmd}</code>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // "Approve all" applies the proposed fixes in the mockup; pressing it again undoes them.
  document.querySelectorAll<HTMLElement>('[data-review]').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('[data-review-toggle]');
    btn?.addEventListener('click', () => {
      const applied = fig.classList.toggle('is-applied');
      btn.textContent = (applied ? btn.dataset.undo : btn.dataset.apply) ?? '';
      btn.setAttribute('aria-pressed', String(applied));
    });
  });
</script>

<style is:global>
  .providers-section {
    --cap-warn: #B23A27;
  }

  [data-theme='dark'] .providers-section {
    --cap-warn: #E58A78;
  }

  /* ---------- Capability cards ---------- */
  /* Bento: the two heaviest capabilities (reports, formulas) take two columns. */
  .caps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.05rem;
  }

  .cap-card.is-wide {
    grid-column: span 2;
  }

  .cap-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      border-color 0.22s ease,
      transform 0.2s ease,
      box-shadow 0.22s ease;
  }

  .cap-card:hover {
    border-color: var(--hairline-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .cap-fig {
    height: 196px;
    padding: 1rem 1.15rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cap-title {
    margin: 1.05rem 1.15rem 0.3rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink-primary);
  }

  .cap-text {
    margin: 0 1.15rem 1.15rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink-secondary);
  }

  /* Shared mini spreadsheet surfaces */
  .file-chip,
  .rep-doc,
  .mini-sheet,
  .fx-bar,
  .kpi {
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
  }

  /* Cross-file report */
  .join-files {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .file-chip {
    height: 26px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    white-space: nowrap;
  }

  .file-dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent-primary);
    opacity: 0.7;
  }

  /* Flow: [files] -> [AI] -> [report], drawn as static links with ports at both ends. */
  .flow {
    height: 94px;
    flex-shrink: 0;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
  }

  .flow-in {
    width: 64px;
  }

  .flow-out {
    width: 48px;
  }

  .base-stop-start {
    stop-color: var(--ink-muted);
    stop-opacity: 0.45;
  }

  .base-stop-end {
    stop-color: var(--accent-primary);
    stop-opacity: 0.9;
  }

  .flow-base path {
    stroke-width: 1.6;
  }

  .flow-base-out path {
    stroke: var(--accent-primary);
    stroke-opacity: 0.9;
  }

  .flow-ports circle {
    fill: var(--surface);
    stroke: var(--accent-primary);
    stroke-width: 1.5;
  }

  /* AI node: a plain labelled box between the files and the report. */
  .ai-core {
    flex-shrink: 0;
    align-self: center;
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--hairline-strong);
    border-radius: 3px;
    background: var(--surface);
    color: var(--accent-gold);
  }

  .ai-core span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .rep-doc {
    flex: 1;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 9px 11px 8px;
    border-color: var(--accent-primary);
    box-shadow: 0 8px 18px -14px rgba(0, 0, 0, 0.45);
  }

  .rep-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 5px;
    margin-bottom: 1px;
    border-bottom: 1px solid var(--hairline);
  }

  .rep-head strong {
    font-size: 0.74rem;
    color: var(--ink-primary);
    letter-spacing: 0.02em;
  }

  .rep-head span {
    color: var(--ink-faint);
  }

  .rep-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: 8px;
  }

  .rep-row b {
    font-weight: 600;
    color: var(--ink-primary);
  }

  .rep-icon {
    width: 14px;
    height: 14px;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 0.5rem;
    font-weight: 700;
    border-radius: 2px;
    color: var(--accent-primary);
    background: var(--accent-primary-soft);
  }

  .rep-row.is-down .rep-icon,
  .rep-row.is-warn .rep-icon {
    color: var(--cap-warn);
    background: color-mix(in srgb, var(--cap-warn) 14%, transparent);
  }

  .rep-row.is-up b {
    color: var(--accent-primary);
  }

  .rep-row.is-down b,
  .rep-row.is-warn b {
    color: var(--cap-warn);
  }

  .rep-spark {
    height: 18px;
    margin-top: 2px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }

  .rep-spark span {
    flex: 1;
    height: var(--h);
    border-radius: 1px 1px 0 0;
    background: color-mix(in srgb, var(--accent-primary) 28%, transparent);
  }

  .rep-spark span:last-child {
    background: var(--accent-primary);
  }

  /* Findings get "written" again each time the card is hovered. */
  .cap-card:hover .rep-row {
    animation: rep-in 0.45s ease both;
    animation-delay: calc(var(--i) * 140ms);
  }

  @keyframes rep-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
  }

  /* Reviews and fixes */
  .fig-review {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }

  .mini-sheet {
    overflow: hidden;
  }

  .mini-row {
    display: grid;
    grid-template-columns: 26px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-top: 1px solid var(--hairline);
  }

  .mini-row:first-child {
    border-top: none;
  }

  .mini-row .ref {
    color: var(--ink-faint);
  }

  .mini-row .val {
    color: var(--ink-primary);
    display: flex;
    gap: 6px;
    white-space: nowrap;
  }

  .mini-row {
    background: color-mix(in srgb, var(--cap-warn) 7%, transparent);
    box-shadow: inset 2px 0 0 var(--cap-warn);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .fig-review .v-fixed {
    display: none;
  }

  .fig-review .val .v-pending {
    display: inline-flex;
    gap: 6px;
  }

  .fig-review.is-applied .v-pending {
    display: none;
  }

  .fig-review.is-applied .v-fixed {
    display: inline;
  }

  .fig-review.is-applied .mini-row {
    background: var(--accent-primary-soft);
    box-shadow: inset 2px 0 0 var(--accent-primary);
  }

  .fig-review.is-applied .mini-row .tag,
  .cap-card:hover .fig-review.is-applied .mini-row .tag {
    color: var(--accent-primary);
    border-color: color-mix(in srgb, var(--accent-primary) 45%, transparent);
  }

  .fig-review.is-applied .mini-row .tag::before {
    content: '\2713  ';
  }

  .fig-review.is-applied .review-foot {
    color: var(--accent-primary);
  }

  .mini-row s {
    color: var(--cap-warn);
    transition: opacity 0.3s ease;
  }

  .mini-row b {
    font-weight: 600;
    color: var(--accent-primary);
  }

  .mini-row b.is-error {
    color: var(--cap-warn);
  }

  .mini-row .tag {
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--hairline-strong);
    color: var(--ink-muted);
    font-size: 0.6rem;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .cap-card:hover .mini-row s {
    opacity: 0.35;
  }

  .cap-card:hover .mini-row .tag {
    color: var(--cap-warn);
    border-color: color-mix(in srgb, var(--cap-warn) 45%, transparent);
  }

  .review-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ink-muted);
  }

  .review-pill {
    padding: 3px 9px;
    border: 1px solid var(--btn-bg);
    border-radius: var(--radius-xs);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .review-pill:hover {
    background: var(--btn-bg-hover, var(--btn-bg));
  }

  .review-pill:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .fig-review.is-applied .review-pill {
    background: transparent;
    color: var(--ink-primary);
    border-color: var(--hairline-strong);
  }

  /* AI formulas */
  .fig-formula {
    flex-direction: column;
    align-items: stretch;
    gap: 5px;
  }

  .fx-block {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: start;
    gap: 10px;
  }

  .fx-label {
    padding-top: 7px;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .fx-block.is-new .fx-label {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .fx-bar {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 8px;
    min-width: 0;
  }

  .fx-bar .fx {
    font-style: italic;
    color: var(--ink-faint);
    padding-right: 8px;
    border-right: 1px solid var(--hairline);
    flex-shrink: 0;
  }

  .fx-bar code {
    font-family: inherit;
    font-size: inherit;
    line-height: 1.5;
    background: none;
    border: none;
    padding: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* The legacy formula is long on purpose: show two lines, then fade out. */
  .fx-block.is-old code {
    color: var(--ink-muted);
    max-height: 3em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent);
    mask-image: linear-gradient(180deg, #000 55%, transparent);
  }

  .fx-block.is-new .fx-bar {
    border-color: var(--accent-primary);
  }

  .fx-block.is-new code {
    color: var(--ink-primary);
    font-weight: 600;
  }

  .fx-arrow {
    width: 14px;
    height: 14px;
    margin-left: 62px;
    fill: none;
    stroke: var(--accent-primary);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s ease;
  }

  .cap-card:hover .fx-arrow {
    transform: translateY(2px);
  }

  .fx-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 5px;
    padding-left: 62px;
  }

  .fx-check {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    background: var(--accent-primary-soft);
    color: var(--accent-primary);
    font-weight: 600;
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .fx-check::before {
    content: '\2713';
  }

  .fx-check.is-status {
    background: var(--accent-gold-soft);
    color: var(--accent-gold);
  }

  /* Metrics and dashboards */
  .fig-dash {
    gap: 12px;
    align-items: stretch;
  }

  .kpis {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  .kpi {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    padding: 6px 10px;
  }

  .kpi strong {
    font-size: 0.95rem;
    color: var(--ink-primary);
  }

  .kpi em {
    font-style: normal;
    font-weight: 600;
    color: var(--accent-primary);
  }

  .chart {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    column-gap: 6px;
    row-gap: 4px;
    font-size: 0.56rem;
    color: var(--ink-faint);
  }

  .chart-y {
    position: relative;
    width: 3.2em;
  }

  .chart-y span {
    position: absolute;
    right: 0;
    bottom: var(--y);
    transform: translateY(50%);
    line-height: 1;
    white-space: nowrap;
  }

  .chart-plot {
    position: relative;
    border-left: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .chart-grid {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--y);
    border-top: 1px dashed var(--hairline);
  }

  .chart-x {
    grid-column: 2;
    display: flex;
    gap: 4px;
    padding: 0 4px;
  }

  .chart-x span {
    flex: 1;
    text-align: center;
  }

  .bars {
    position: absolute;
    inset: 0 4px;
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }

  .bar {
    flex: 1;
    height: var(--h);
    background: color-mix(in srgb, var(--accent-primary) 30%, transparent);
