---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import VirtualGridSection from './VirtualGridSection.astro';
import ProvidersSection from './ProvidersSection.astro';
import DownloadSection from './DownloadSection.astro';
import Footer from './Footer.astro';
import { LANG_STORAGE_KEY, homePath, otherLang, t, type Lang } from '../i18n/ui';
import '../styles/v4.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const alt = otherLang(lang);
---

<BaseLayout lang={lang} alternates>
  <div class="v4-page v15-override">
    <header class="v4-header">
      <nav class="v4-nav-bar" aria-label={d.nav.primary}>
        <a class="v4-brand" href={homePath(lang)}>
          <svg width="24" height="24" viewBox="0 0 128 128" fill="none" aria-hidden="true">
            <rect width="128" height="128" rx="14" fill="#03667A" />
            <rect x="4" y="4" width="120" height="120" rx="11" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
            <path d="M44 20V108M84 20V108M20 44H108M20 84H108" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
            <path d="M28 30H100V44L48 84H100V98H28V84L80 44H28V30Z" fill="#FFFFFF" />
            <rect x="84" y="20" width="24" height="24" fill="#08161A" />
          </svg>
          <span>Zenkai</span>
        </a>
        <div class="v4-nav-links">
          <a href="#grid">{d.nav.grid}</a>
          <a href="#providers">{d.nav.ai}</a>
          <a href="#download">{d.nav.download}</a>
        </div>
        <div class="v4-nav-actions">
          <a
            class="icon-link lang-link"
            href={homePath(alt)}
            hreflang={alt}
            lang={alt}
            aria-label={d.nav.switchTo}
            title={d.nav.switchTo}
            data-set-lang={alt}
          >
            {alt.toUpperCase()}
          </a>
          <a class="icon-link" href="https://github.com/EmilioGiordano/Zenkai" target="_blank" rel="noopener noreferrer" aria-label={d.nav.github}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
          </a>
          <button class="theme-toggle" id="zenkai-theme-toggle" type="button" aria-label={d.nav.themeToggle}>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            <span class="theme-labels">
              <span class="label-light">{d.nav.themeLight}</span>
              <span class="label-dark">{d.nav.themeDark}</span>
            </span>
          </button>
          <a class="btn btn-primary btn-sm" href="#download">{d.nav.download}</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <Hero lang={lang} />
      <VirtualGridSection lang={lang} />
      <ProvidersSection lang={lang} />

      <!-- Unified single-artwork backdrop spanning seamlessly across Download + Footer -->
      <div class="v15-closing-band">
        <div class="v15-closing-art" aria-hidden="true">
          <div class="v15-closing-layer v15-closing-light"></div>
          <div class="v15-closing-layer v15-closing-dark"></div>
          <div class="v15-closing-scrim"></div>
        </div>
        <DownloadSection lang={lang} />
        <Footer lang={lang} />
      </div>
    </main>
  </div>

  <script is:inline define:vars={{ langKey: LANG_STORAGE_KEY }}>
    // Remember an explicit language choice so the auto-redirect on "/" respects it.
    document.querySelectorAll('[data-set-lang]').forEach(function (link) {
      link.addEventListener('click', function () {
        try { localStorage.setItem(langKey, link.getAttribute('data-set-lang')); } catch (e) {}
      });
    });
  </script>

  <script is:inline>
    // In-page links scroll to their section without writing "#section" into the URL.
    // The href stays as a real anchor, so links still work without JavaScript.
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.addEventListener('click', function (e) {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var link = e.target.closest && e.target.closest('a[href^="#"]:not(.skip-link)');
        if (!link) return;
        var id = link.getAttribute('href').slice(1);
        var target = id && document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
      });
      // Shared links like /#download still land on the section; then tidy the URL.
      window.addEventListener('load', function () {
        if (location.hash && document.getElementById(location.hash.slice(1))) {
          history.replaceState(null, '', location.pathname + location.search);
        }
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var btn = document.getElementById('zenkai-theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('zenkai-natural-theme', next); } catch (e) {}
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  /* Light: warm paper under the cerulean hero; teal for UI, the hero's gold for highlights. */
  .v15-override {
    --bg: #F5F3EE;
    --bg-subtle: #ECE8DF;
    --surface: #FFFEFB;
    --hairline: rgba(38, 33, 24, 0.10);
    --hairline-strong: rgba(38, 33, 24, 0.19);
    --ink-primary: #15191A;
    --ink-secondary: #3B4446;
    --ink-muted: #565E5F;
    --ink-faint: #5B6263;
    --accent-gold: #94600F;
    --title-gold: #A8740F;
    --accent-gold-soft: rgba(196, 140, 40, 0.14);
    --accent-primary: #03667A;
    --accent-primary-hover: #025161;
    --accent-primary-soft: rgba(3, 102, 122, 0.12);
    --accent-secondary: #03667A;
    --btn-bg: #08181C;
    --btn-fg: #FFFFFF;
    --btn-bg-hover: #14333B;

    --hero-text: #FFFFFF;
    --hero-text-muted: #F0F9FB;
    --hero-scrim-top: rgba(3, 50, 62, 0.58);
    --hero-scrim-mid: rgba(3, 76, 92, 0.22);
    --hero-scrim-bottom: #F5F3EE;

    --radius-sm: 2px;
    --radius-md: 2px;
    --radius-lg: 3px;
  }

  /* Dark: matte alpine night. Slate surfaces, a desaturated glacier blue for UI,
     moonlit sand for highlights, off-white primary buttons instead of neon fills. */
  [data-theme='dark'] .v15-override {
    --bg: #0A0F14;
    --bg-subtle: #10171E;
    --surface: #151E26;
    --hairline: rgba(226, 232, 238, 0.09);
    --hairline-strong: rgba(226, 232, 238, 0.17);
    --ink-primary: #ECEFF1;
    --ink-secondary: #B5BFC5;
    --ink-muted: #8D99A0;
    --ink-faint: #828E95;
    --accent-gold: #DCC28A;
    --title-gold: #E6CF9B;
    --accent-gold-soft: rgba(220, 194, 138, 0.13);
    --accent-primary: #8FB6C3;
    --accent-primary-hover: #A8C8D2;
    --accent-primary-soft: rgba(143, 182, 195, 0.12);
    --accent-secondary: #8FB6C3;
    --btn-bg: #E2C27F;
    --btn-fg: #1A1408;
    --btn-bg-hover: #ECD29B;

    /* Demo window: same matte palette instead of neon green and saturated blue. */
    --win-bg: #0D1318;
    --win-chrome: #131B22;
    --win-sidebar: #10171E;
    --win-toolbar: #131B22;
    --win-grid-header: #18212A;
    --win-tbl-head-bg: #2B4A63;
    --win-row-hover: rgba(143, 182, 195, 0.05);
    --win-cell-selected-bg: rgba(143, 182, 195, 0.14);
    --win-cell-selected-border: #8FB6C3;
    --win-proposal-bg: rgba(220, 194, 138, 0.10);
    --win-proposal-border: #DCC28A;
    --hero-scrim-top: rgba(10, 15, 20, 0.62);
    --hero-scrim-mid: rgba(10, 15, 20, 0.22);
    --hero-scrim-bottom: #0A0F14;
  }

  /* Section titles share the hero's gold highlight. */
  .v15-override .section-title em {
    color: var(--title-gold);
  }

  .v15-override .v4-nav-bar {
    border-radius: 2px;
  }

  .v15-override .lang-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .v15-override .hero {
    padding-top: 8.2rem;
    background: #03667A;
  }

  [data-theme='dark'] .v15-override .hero {
    background: #0A0F14;
  }

  /* High-contrast Hero Typography (Light & Dark) */
  .v15-override .hero-kicker {
    background: rgba(4, 30, 38, 0.46) !important;
    border-color: rgba(255, 255, 255, 0.34) !important;
    color: #FFFFFF !important;
    backdrop-filter: blur(10px);
  }

  .v15-override .hero-kicker-dot {
    background: #FFE08A !important;
    box-shadow: 0 0 0 3px rgba(255, 224, 138, 0.28) !important;
  }

  .v15-override .hero-title {
    color: #FFFFFF !important;
    text-shadow: 0 2px 26px rgba(3, 30, 38, 0.52) !important;
  }

  /* Warm sunlit gold "too large" pops cleanly against #03667A cerulean sky */
  .v15-override .hero-title em {
    color: #FFE08A !important;
    text-shadow: 0 2px 22px rgba(3, 28, 36, 0.62) !important;
  }

  .v15-override .hero-sub {
    color: #F3FAFC !important;
    text-shadow: 0 1px 16px rgba(3, 30, 38, 0.58) !important;
  }

  .v15-override .hero-sub code {
    background: rgba(4, 30, 38, 0.44) !important;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF !important;
    padding: 1px 6px;
    border-radius: 2px;
  }

  .v15-override .hero .btn-ghost {
    background: rgba(4, 30, 38, 0.38) !important;
    color: #FFFFFF !important;
    border-color: rgba(255, 255, 255, 0.50) !important;
  }

  .v15-override .hero .btn-ghost:hover {
    background: rgba(4, 30, 38, 0.56) !important;
    border-color: #FFFFFF !important;
  }

  [data-theme='dark'] .v15-override .hero-kicker-dot {
    background: #DCC28A !important;
    box-shadow: 0 0 0 3px rgba(220, 194, 138, 0.24) !important;
  }

  [data-theme='dark'] .v15-override .hero-title em {
    color: #E6CF9B !important;
    text-shadow: 0 2px 24px rgba(4, 14, 20, 0.78) !important;
  }

  /* Hero Light: Cerulean-Teal Duotone Alpine Peaks */
  .v15-override .backdrop-light {
    background-color: #03667A !important;
    background-image: url('/art/hero-day.webp') !important;
    background-position: center 48% !important;
    background-blend-mode: luminosity !important;
    filter: contrast(1.24) brightness(1.04) !important;
  }

  /* Hero Dark: Julian Alps Starlight Milky Way */
  .v15-override .backdrop-dark {
    background-color: #0A0F14 !important;
    background-image: url('/art/hero-night.webp') !important;
    background-position: center 36% !important;
    background-size: cover !important;
    filter: saturate(0.82) contrast(1.04) brightness(0.92) !important;
  }

  .v15-override .hero-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 4px 4px;
    pointer-events: none;
  }

  /* ==========================================================================
     Unified Download + Footer Closing Band (ONE single continuous artwork)
     ========================================================================== */
  .v15-closing-band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--hairline);
  }

  .v15-closing-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .v15-closing-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 54%;
    transition: opacity var(--t-bg);
  }

  .v15-closing-light {
    background-color: #03667A;
    background-image: url('/art/hero-day.webp');
    background-blend-mode: luminosity;
    filter: contrast(1.2) brightness(1.02);
    opacity: 1;
  }

  .v15-closing-dark {
    background-color: #0A0F14;
    background-image: url('/art/horizon-night.webp');
    background-position: center 46%;
    filter: saturate(0.82) contrast(1.04) brightness(0.82);
    opacity: 0;
  }

  [data-theme='dark'] .v15-closing-light {
    opacity: 0;
  }

  [data-theme='dark'] .v15-closing-dark {
    opacity: 1;
  }

  /* Seamless top fade from --bg into the continuous artwork, darkening cleanly at the footer */
  .v15-closing-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 82%, transparent) 16%,
      color-mix(in srgb, var(--bg) 34%, transparent) 42%,
      rgba(4, 34, 42, 0.62) 72%,
      rgba(3, 24, 30, 0.88) 100%
    );
  }

  [data-theme='dark'] .v15-closing-scrim {
    background: linear-gradient(
      180deg,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 78%, transparent) 16%,
      rgba(10, 15, 20, 0.36) 44%,
      rgba(10, 15, 20, 0.72) 74%,
      rgba(7, 10, 14, 0.92) 100%
    );
  }

  /* Hide inner duplicated art layers inside Download & Footer */
  .v15-closing-band .download-section {
    border-top: none;
    background: transparent;
    padding-bottom: 3.5rem;
  }

  .v15-closing-band .download-art-layer,
  .v15-closing-band .footer-backdrop {
    display: none !important;
  }

  .v15-closing-band .site-footer {
    background: transparent;
    padding-top: 3.5rem;
  }

  /* Crisp, high-contrast light ink for the Footer over the unified alpine horizon */
  .v15-closing-band .site-footer .brand,
  .v15-closing-band .site-footer .footer-quote,
  .v15-closing-band .site-footer .footer-col a {
    color: #FFFFFF;
  }

  .v15-closing-band .site-footer .footer-col h4 {
    color: #FFE7A8;
  }

  .v15-closing-band .site-footer .footer-col span {
    color: rgba(240, 250, 252, 0.82);
  }

  .v15-closing-band .site-footer .footer-bottom {
    color: rgba(240, 250, 252, 0.84);
    border-top-color: rgba(255, 255, 255, 0.22);
  }
</style>
