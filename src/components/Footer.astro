---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).footer;
---

<footer class="site-footer">
  <div class="footer-backdrop" aria-hidden="true">
    <div class="footer-layer footer-light"></div>
    <div class="footer-layer footer-dark"></div>
    <div class="footer-scrim"></div>
  </div>

  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <div class="brand">
          <svg width="24" height="24" viewBox="0 0 128 128" fill="none" aria-hidden="true" style="display:block;border-radius:3px;">
            <rect width="128" height="128" rx="14" fill="#03667A" />
            <rect x="4" y="4" width="120" height="120" rx="11" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
            <path d="M44 20V108M84 20V108M20 44H108M20 84H108" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
            <path d="M28 30H100V44L48 84H100V98H28V84L80 44H28V30Z" fill="#FFFFFF" />
            <rect x="84" y="20" width="24" height="24" fill="#08161A" />
          </svg>
          <span>Zenkai</span>
        </div>
        <p class="footer-quote">{d.quote}</p>
      </div>

      <div class="footer-col">
        <h4>{d.sections}</h4>
        <ul>
          <li><a href="#grid">{d.linkGrid}</a></li>
          <li><a href="#providers">{d.linkAi}</a></li>
          <li><a href="#download">{d.linkDownload}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{d.openSource}</h4>
        <ul>
          <li>
            <a href="https://github.com/EmilioGiordano/Zenkai" target="_blank" rel="noopener noreferrer">
              {d.repo}
            </a>
          </li>
          <li>
            <a href="https://github.com/EmilioGiordano/Zenkai/releases" target="_blank" rel="noopener noreferrer">
              {d.releases}
            </a>
          </li>
          <li>
            <a href="https://github.com/EmilioGiordano/Zenkai/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">
              {d.license}
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{d.stack}</h4>
        <ul>
          <li><span>Rust + GPUI</span></li>
          <li><span>{d.engine}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-facts"><span>Zenkai</span><span>{d.factOss}</span></span>
      <span class="footer-facts"><span>{d.photoCredit}</span><span>Eddie Basler (CC BY-SA 4.0)</span></span>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    position: relative;
    padding: 7.5rem 0 4rem;
    overflow: hidden;
  }

  .footer-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .footer-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 48%;
    transition: opacity var(--t-bg);
  }

  .footer-light {
    background-image: url('/art/hero-day.webp');
    opacity: 1;
  }

  .footer-dark {
    background-image: url('/art/horizon-night.webp');
    background-position: center 56%;
    opacity: 0;
  }

  [data-theme='dark'] .footer-light {
    opacity: 0;
  }

  [data-theme='dark'] .footer-dark {
    opacity: 1;
  }

  .footer-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--footer-scrim-top) 0%,
      color-mix(in srgb, var(--footer-scrim-top) 92%, transparent) 18%,
      var(--footer-scrim-mid) 46%,
      var(--footer-scrim-bottom) 100%
    );
  }

  .footer-inner {
    position: relative;
    z-index: 2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .footer-quote {
    font-family: var(--font-serif);
    font-size: 1.48rem;
    line-height: 1.25;
    color: var(--ink-primary);
    margin-top: 0.75rem;
    max-width: 26ch;
  }

  .footer-col h4 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.8rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
  }

  .footer-col a {
    color: var(--ink-primary);
    opacity: 0.84;
    transition: opacity 0.15s ease;
  }

  .footer-col a:hover {
    opacity: 1;
  }

  .footer-col span {
    color: var(--ink-secondary);
  }

  .footer-facts {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.1rem;
  }

  .footer-facts > span + span {
    padding-left: 1.1rem;
    border-left: 1px solid currentColor;
    border-left-color: color-mix(in srgb, currentColor 35%, transparent);
  }

  .footer-bottom {
    padding-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--footer-bottom-ink);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
    }

    .footer-facts {
      gap: 0.35rem 0.8rem;
    }

    .footer-bottom > .footer-facts:last-child {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-bottom > .footer-facts:last-child > span + span {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
