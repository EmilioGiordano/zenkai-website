---
import '../styles/tokens.css';
import '../styles/global.css';
import { LANG_STORAGE_KEY, defaultLang, homePath, languages, t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Emit hreflang links to the other translations of this page (home only). */
  alternates?: boolean;
}

const { lang = defaultLang, alternates = false } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const langs = Object.keys(languages) as Lang[];
// Only the default-language home auto-redirects, and only on a first visit.
const autoRedirect = alternates && lang === defaultLang;
---

<!doctype html>
<html lang={d.htmlLang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath(l), Astro.site)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLang), Astro.site)} />}
    <meta name="theme-color" content="#03667A" />

    {
      autoRedirect && (
        <script is:inline define:vars={{ langKey: LANG_STORAGE_KEY }}>
          // First visit with a Spanish browser: show the Spanish page. An explicit choice in the nav wins.
          try {
            if (!localStorage.getItem(langKey)) {
              var pref = (navigator.languages && navigator.languages[0]) || navigator.language || '';
              if (/^es\b/i.test(pref)) location.replace('/es/' + location.search + location.hash);
            }
          } catch (e) {}
        </script>
      )
    }

    <!-- Social previews (WhatsApp, LinkedIn, X, Slack, Discord) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zenkai" />
    <meta property="og:locale" content={d.ogLocale} />
    {
      alternates &&
        langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l).ogLocale} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Zero-FOUC theme initialization -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('zenkai-natural-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts: Newsreader, Plus Jakarta Sans, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{d.meta.skip}</a>
    <div class="paper-grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
