---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Zenkai">
  <main id="main-content" class="nf-page">
    <div class="nf-art" aria-hidden="true">
      <div class="nf-layer nf-light"></div>
      <div class="nf-layer nf-dark"></div>
      <div class="nf-scrim"></div>
    </div>

    <div class="nf-inner">
      <a class="nf-brand" href="/">
        <svg width="28" height="28" viewBox="0 0 128 128" fill="none" aria-hidden="true">
          <rect width="128" height="128" rx="14" fill="#03667A" />
          <rect x="4" y="4" width="120" height="120" rx="11" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
          <path d="M44 20V108M84 20V108M20 44H108M20 84H108" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
          <path d="M28 30H100V44L48 84H100V98H28V84L80 44H28V30Z" fill="#FFFFFF" />
          <rect x="84" y="20" width="24" height="24" fill="#08161A" />
        </svg>
        <span>Zenkai</span>
      </a>

      <div class="nf-cell" aria-hidden="true">
        <div class="nf-fx">
          <span class="nf-ref">A404</span>
          <span class="nf-fx-icon">fx</span>
          <code>=LOOKUP("this page")</code>
        </div>
        <div class="nf-result">#N/A</div>
      </div>

      <h1 class="nf-title">This cell is <em>empty</em>.</h1>
      <p class="nf-sub">The page you are looking for does not exist or has moved.</p>

      <a class="btn btn-primary nf-btn" href="/">Back to Zenkai</a>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .nf-page {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 3rem 1.25rem;
    overflow: hidden;
    color: #ffffff;
    background: #03667a;
  }

  [data-theme='dark'] .nf-page {
    background: #060e12;
  }

  .nf-art,
  .nf-layer,
  .nf-scrim {
    position: absolute;
    inset: 0;
  }

  .nf-layer {
    background-size: cover;
    transition: opacity var(--t-bg);
  }

  .nf-light {
    background-color: #03667a;
    background-image: url('/art/hero-day.webp');
    background-position: center 48%;
    background-blend-mode: luminosity;
    filter: contrast(1.24) brightness(1.04);
  }

  .nf-dark {
    background-image: url('/art/hero-night.webp');
    background-position: center 36%;
    filter: saturate(1.16) contrast(1.08);
    opacity: 0;
  }

  [data-theme='dark'] .nf-light {
    opacity: 0;
  }

  [data-theme='dark'] .nf-dark {
    opacity: 1;
  }

  .nf-scrim {
    background:
      radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px) 0 0 / 4px 4px,
      linear-gradient(180deg, rgba(3, 50, 62, 0.66), rgba(3, 40, 50, 0.5));
  }

  [data-theme='dark'] .nf-scrim {
    background:
      radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px) 0 0 / 4px 4px,
      linear-gradient(180deg, rgba(6, 14, 18, 0.7), rgba(6, 14, 18, 0.45));
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .nf-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 2.6rem;
  }

  .nf-brand svg {
    border-radius: 3px;
  }

  .nf-cell {
    width: 100%;
    max-width: 380px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: rgba(255, 255, 255, 0.96);
    color: #08181c;
    border-radius: 2px;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    text-align: left;
  }

  .nf-fx {
    display: flex;
    align-items: center;
    height: 34px;
    border-bottom: 1px solid rgba(8, 24, 28, 0.12);
  }

  .nf-ref {
    width: 64px;
    height: 100%;
    display: grid;
    place-items: center;
    font-weight: 600;
    border-right: 1px solid rgba(8, 24, 28, 0.12);
  }

  .nf-fx-icon {
    padding: 0 10px;
    font-family: var(--font-serif);
    font-style: italic;
    color: #56737a;
  }

  .nf-fx code {
    font-family: inherit;
    background: none;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nf-result {
    padding: 0.9rem 1rem;
    font-size: 1.6rem;
    font-weight: 600;
    color: #c2412d;
    box-shadow: inset 2px 0 0 #c2412d;
    background: rgba(194, 65, 45, 0.07);
  }

  .nf-title {
    margin-top: 2.2rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 26px rgba(3, 30, 38, 0.5);
  }

  .nf-title em {
    color: #ffe08a;
  }

  [data-theme='dark'] .nf-title em {
    color: #5ce6ff;
  }

  .nf-sub {
    margin-top: 0.8rem;
    color: #f0f9fb;
    font-size: 1rem;
  }

  .nf-btn {
    margin-top: 1.8rem;
    background: #08181c;
    color: #ffffff;
    border-color: #08181c;
  }

  [data-theme='dark'] .nf-btn {
    background: #22d3ee;
    color: #041418;
    border-color: #22d3ee;
  }
</style>
