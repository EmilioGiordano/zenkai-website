---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VirtualGridSection from '../components/VirtualGridSection.astro';
import ProvidersSection from '../components/ProvidersSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/v4.css';
---

<BaseLayout title="Zenkai — v10 Orbit Classical Engraving">
  <div class="v4-page v10-override">
    <header class="v4-header">
      <nav class="v4-nav-bar" aria-label="Primary">
        <a class="v4-brand" href="/v10">
          <svg width="24" height="24" viewBox="0 0 128 128" fill="none" aria-hidden="true">
            <rect width="128" height="128" rx="14" fill="#143CE8" />
            <rect x="4" y="4" width="120" height="120" rx="11" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
            <path d="M44 20V108M84 20V108M20 44H108M20 84H108" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
            <path d="M28 30H100V44L48 84H100V98H28V84L80 44H28V30Z" fill="#FFFFFF" />
            <rect x="84" y="20" width="24" height="24" fill="#0B132B" />
          </svg>
          <span>Zenkai</span>
        </a>

        <div class="v4-nav-links">
          <a href="#grid">Grid</a>
          <a href="#providers">Providers</a>
          <a href="#download">Download</a>
          <a href="/versions" class="v4-versions-link">Versions ↗</a>
        </div>

        <div class="v4-nav-actions">
          <a class="icon-link" href="https://github.com/EmilioGiordano/Zenkai" target="_blank" rel="noopener noreferrer" aria-label="Zenkai on GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <button class="theme-toggle" id="v10-theme-toggle" type="button" aria-label="Toggle Light and Dark theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <span class="label-light">Engraving</span>
            <span class="label-dark">Blueprint</span>
          </button>
          <a class="btn btn-primary btn-sm" href="#download">Download</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <Hero />
      <VirtualGridSection />
      <ProvidersSection />
      <DownloadSection />
    </main>

    <Footer />
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('v10-theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('zenkai-natural-theme', next); } catch (e) {}
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  /* v10: Orbit Classical Engraving — Electric Klein Blue (#143CE8) + Piranesi Etching Duotone */
  .v10-override {
    --bg: #F2F3F6;
    --bg-subtle: #E5E8F0;
    --surface: #FFFFFF;
    --ink-primary: #0B1020;
    --ink-secondary: #343E59;
    --ink-muted: #5B6682;

    --accent-primary: #143CE8;
    --accent-primary-hover: #0E2EC2;
    --accent-primary-soft: rgba(20, 60, 232, 0.11);
    --accent-secondary: #143CE8;
    --btn-bg: #0B1020;
    --btn-fg: #FFFFFF;
    --btn-bg-hover: #1C2645;

    --hero-text: #FFFFFF;
    --hero-text-muted: rgba(255, 255, 255, 0.90);
    --hero-scrim-top: rgba(16, 46, 198, 0.52);
    --hero-scrim-mid: rgba(20, 60, 232, 0.24);
    --hero-scrim-bottom: #F2F3F6;
    --footer-scrim-top: #F2F3F6;
    --footer-scrim-mid: rgba(20, 60, 232, 0.34);
    --footer-scrim-bottom: rgba(8, 22, 92, 0.84);

    --radius-sm: 2px;
    --radius-md: 2px;
    --radius-lg: 3px;
  }

  [data-theme='dark'] .v10-override {
    --bg: #070B18;
    --bg-subtle: #0D1429;
    --surface: #111A33;
    --accent-primary: #4F8CFF;
    --accent-primary-hover: #73A5FF;
    --accent-primary-soft: rgba(79, 140, 255, 0.16);
    --btn-bg: #4F8CFF;
    --btn-fg: #050914;
    --hero-scrim-top: rgba(7, 11, 24, 0.56);
    --hero-scrim-mid: rgba(14, 34, 110, 0.28);
    --hero-scrim-bottom: #070B18;
    --footer-scrim-top: #070B18;
  }

  .v10-override .v4-nav-bar { border-radius: 2px; }
  .v10-override .hero { padding-top: 8.2rem; background: #143CE8; }
  [data-theme='dark'] .v10-override .hero { background: #070B18; }
  .v10-override .hero-title em { color: #BFD7FF !important; }

  /* Electric Klein-Blue Duotone Classical Piranesi Engraving (Orbit style) */
  .v10-override .backdrop-light {
    background-color: #143CE8 !important;
    background-image: url('/art/v9-pack/piranesi-forum.jpg') !important;
    background-position: center 42% !important;
    background-size: 134% auto !important;
    background-blend-mode: multiply !important;
    filter: contrast(1.38) brightness(1.06) !important;
  }

  /* Inverted White-on-Navy Architectural Pantheon Blueprint for Dark Mode */
  .v10-override .backdrop-dark {
    background-color: #091338 !important;
    background-image: url('/art/v9-pack/piranesi-pantheon.jpg') !important;
    background-position: center 46% !important;
    background-size: 122% auto !important;
    background-blend-mode: screen !important;
    filter: invert(1) contrast(1.25) brightness(0.42) sepia(1) hue-rotate(192deg) saturate(4.2) !important;
  }

  /* Subtle halftone dot-screen overlay over hero artwork */
  .v10-override .hero-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 4px 4px;
    pointer-events: none;
  }

  /* Pantheon Blueprint Duotone for Download & Footer */
  .v10-override .download-art-layer::before,
  .v10-override .footer-light {
    background-color: #143CE8 !important;
    background-image: url('/art/v9-pack/piranesi-pantheon.jpg') !important;
    background-position: center 48% !important;
    background-size: 118% auto !important;
    background-blend-mode: multiply !important;
    filter: contrast(1.35) brightness(1.08) !important;
  }

  .v10-override .download-art-layer::after,
  .v10-override .footer-dark {
    background-color: #091338 !important;
    background-image: url('/art/v9-pack/piranesi-forum.jpg') !important;
    background-position: center 44% !important;
    background-size: 132% auto !important;
    filter: invert(1) contrast(1.2) brightness(0.36) sepia(1) hue-rotate(195deg) saturate(4.5) !important;
  }
</style>
