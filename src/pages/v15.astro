---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VirtualGridSection from '../components/VirtualGridSection.astro';
import ProvidersSection from '../components/ProvidersSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/v4.css';
---

<BaseLayout title="Zenkai — v15 Cerulean Alpine Halftone">
  <div class="v4-page v15-override">
    <header class="v4-header">
      <nav class="v4-nav-bar" aria-label="Primary">
        <a class="v4-brand" href="/v15">
          <svg width="24" height="24" viewBox="0 0 128 128" fill="none" aria-hidden="true">
            <rect width="128" height="128" rx="14" fill="#03667A" />
            <rect x="4" y="4" width="120" height="120" rx="11" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
            <path d="M44 20V108M84 20V108M20 44H108M20 84H108" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
            <path d="M28 30H100V44L48 84H100V98H28V84L80 44H28V30Z" fill="#FFFFFF" />
            <rect x="84" y="20" width="24" height="24" fill="#08161A" />
          </svg>
          <span>Zenkai</span>
        </a>
        <div class="v4-nav-links">
          <a href="#grid">Grid</a>
          <a href="#providers">Providers</a>
          <a href="#download">Download</a>
          <a href="/versions" class="v4-versions-link">Versions ↗</a>
        </div>
        <div class="v4-nav-actions">
          <a class="icon-link" href="https://github.com/EmilioGiordano/Zenkai" target="_blank" rel="noopener noreferrer" aria-label="Zenkai on GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
          </a>
          <button class="theme-toggle" id="v15-theme-toggle" type="button" aria-label="Toggle Light and Dark theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            <span class="label-light">Cerulean</span>
            <span class="label-dark">Abyss</span>
          </button>
          <a class="btn btn-primary btn-sm" href="#download">Download</a>
        </div>
      </nav>
    </header>
    <main id="main-content"><Hero /><VirtualGridSection /><ProvidersSection /><DownloadSection /></main>
    <Footer />
  </div>
  <script is:inline>
    (function () {
      var btn = document.getElementById('v15-theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('zenkai-natural-theme', next); } catch (e) {}
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  .v15-override {
    --bg: #F2F6F7; --bg-subtle: #E3ECEE; --surface: #FFFFFF;
    --ink-primary: #08181C; --ink-secondary: #2F4B52; --ink-muted: #56737A;
    --accent-primary: #03667A; --accent-primary-hover: #025161;
    --accent-primary-soft: rgba(3, 102, 122, 0.12);
    --accent-secondary: #03667A;
    --btn-bg: #08181C; --btn-fg: #FFFFFF; --btn-bg-hover: #14333B;
    --hero-text: #FFFFFF; --hero-text-muted: rgba(255, 255, 255, 0.90);
    --hero-scrim-top: rgba(3, 82, 98, 0.50);
    --hero-scrim-mid: rgba(3, 102, 122, 0.18);
    --hero-scrim-bottom: #F2F6F7;
    --footer-scrim-top: #F2F6F7;
    --footer-scrim-mid: rgba(3, 102, 122, 0.34);
    --footer-scrim-bottom: rgba(4, 34, 42, 0.86);
    --radius-sm: 2px; --radius-md: 2px; --radius-lg: 3px;
  }
  [data-theme='dark'] .v15-override {
    --bg: #060E12; --bg-subtle: #0C1A20; --surface: #11242C;
    --accent-primary: #22D3EE; --accent-primary-hover: #4BE3FA;
    --accent-primary-soft: rgba(34, 211, 238, 0.16);
    --btn-bg: #22D3EE; --btn-fg: #041418;
    --hero-scrim-top: rgba(6, 14, 18, 0.56);
    --hero-scrim-bottom: #060E12; --footer-scrim-top: #060E12;
  }
  .v15-override .v4-nav-bar { border-radius: 2px; }
  .v15-override .hero { padding-top: 8.2rem; background: #03667A; }
  [data-theme='dark'] .v15-override .hero { background: #060E12; }
  .v15-override .hero-title em { color: #B4F4FF !important; }
  .v15-override .backdrop-light {
    background-color: #03667A !important;
    background-image: url('/art/concepts/05-mist-dawn-peaks.jpg') !important;
    background-position: center 48% !important;
    background-blend-mode: luminosity !important;
    filter: contrast(1.24) brightness(1.04) !important;
  }
  .v15-override .backdrop-dark {
    background-color: #07222A !important;
    background-image: url('/art/v9-pack/celestial-atlas.jpg') !important;
    background-position: center 46% !important;
    background-size: 120% auto !important;
    filter: grayscale(1) invert(1) contrast(1.24) brightness(0.38) sepia(1) hue-rotate(155deg) saturate(4.2) !important;
  }
  .v15-override .hero-backdrop::after {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.14) 1px, transparent 1px);
    background-size: 4px 4px; pointer-events: none;
  }
  .v15-override .download-art-layer::before, .v15-override .footer-light {
    background-color: #03667A !important;
    background-image: url('/art/v9-pack/celestial-atlas.jpg') !important;
    background-size: 118% auto !important;
    background-blend-mode: multiply !important;
    filter: grayscale(1) contrast(1.36) brightness(1.08) !important;
  }
  .v15-override .download-art-layer::after, .v15-override .footer-dark {
    background-color: #07222A !important;
    background-image: url('/art/concepts/05-mist-dawn-peaks.jpg') !important;
    background-position: center 48% !important;
    filter: grayscale(1) contrast(1.22) brightness(0.42) sepia(1) hue-rotate(155deg) saturate(3.2) !important;
  }
</style>
