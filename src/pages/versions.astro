---

<BaseLayout title="Zenkai — Visual Versions Preview">
  <div class="versions-wrap">
    <header class="versions-head">
      <div>
        <p class="versions-kicker">Zenkai Web · Visual Explorations Hub</p>
        <h1 class="versions-title">Compare <em>v1 – v16</em> live</h1>
        <p class="versions-sub">
          Mismo contenido, mismos componentes interactivos de Preact y el Icono 01 oficial — variando únicamente imágenes, paletas y atmósfera visual.
        </p>
      </div>
      <div class="versions-actions">
        <button class="btn btn-ghost btn-sm" id="versions-theme-btn" type="button">
          Toggle Light / Dark
        </button>
      </div>
    </header>

    <main class="versions-grid">
      {
        versions.map((v) => (
          <a class="version-card" href={v.href}>
            <div class="version-thumb-wrap">
              <img
                class="version-thumb"
                src={v.thumb}
                alt={`${v.title} preview`}
                loading="lazy"
                onerror="this.style.opacity='0.15'"
              />
              <span class="version-badge-pill">{v.id}</span>
            </div>
            <div class="version-body">
              <span class="version-tag">{v.tag}</span>
              <h2 class="version-name">{v.title}</h2>
              <p class="version-desc">{v.desc}</p>
              <div class="version-foot">
                <div class="swatches" aria-label="Color palette">
                  {v.swatches.map((hex) => (
                    <span class="swatch" style={`background:${hex}`} title={hex} />
                  ))}
                </div>
                <span class="version-open">Open {v.href} →</span>
              </div>
            </div>
          </a>
        ))
      }
    </main>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('versions-theme-btn');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('zenkai-natural-theme', next);
        } catch (e) {}
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  .versions-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 3.2rem 1.5rem 5rem;
  }

  .versions-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.8rem;
    margin-bottom: 2.2rem;
    border-bottom: 1px solid var(--hairline);
  }

  .versions-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 0.55rem;
  }

  .versions-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .versions-title em {
    font-style: italic;
    color: var(--accent-primary);
  }

  .versions-sub {
    margin-top: 0.55rem;
    max-width: 62ch;
    color: var(--ink-secondary);
    font-size: 0.96rem;
  }

  .versions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.35rem;
  }

  .version-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.2s ease;
  }

  .version-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-card);
  }

  .version-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-subtle);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }

  .version-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .version-card:hover .version-thumb {
    transform: scale(1.03);
  }

  .version-badge-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    background: rgba(12, 12, 14, 0.78);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .version-body {
    padding: 1.25rem 1.3rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .version-tag {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-primary);
    font-weight: 600;
  }

  .version-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink-primary);
  }

  .version-desc {
    font-size: 0.87rem;
    color: var(--ink-secondary);
    line-height: 1.58;
    flex: 1;
  }

  .version-foot {
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .swatches {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .swatch {
    width: 16px;
    height: 16px;
    border-radius: 2px;
    border: 1px solid var(--hairline-strong);
  }

  .version-open {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink-primary);
  }
</style>
