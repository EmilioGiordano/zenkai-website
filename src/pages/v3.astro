---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VirtualGridSection from '../components/VirtualGridSection.astro';
import ProvidersSection from '../components/ProvidersSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/v3.css';
---

<BaseLayout title="Zenkai — Fast, Native Desktop Spreadsheet (v3 Vivid Nature)">
  <div class="v3-page">
    <!-- Floating Architectural Glass Navbar with Official Icon 01 (Monolith Z-Grid) -->
    <header class="v3-header">
      <nav class="v3-nav-bar" aria-label="Primary">
        <a class="v3-brand" href="/v3">
          <svg width="24" height="24" viewBox="0 0 128 128" fill="none" aria-hidden="true">
            <rect width="128" height="128" rx="14" fill="#151715" />
            <rect x="4" y="4" width="120" height="120" rx="11" stroke="rgba(255,255,255,0.14)" stroke-width="2" />
            <path d="M44 20V108M84 20V108M20 44H108M20 84H108" stroke="rgba(255,255,255,0.09)" stroke-width="1.5" />
            <path d="M28 30H100V44L48 84H100V98H28V84L80 44H28V30Z" fill="#F6F5F0" />
            <rect x="84" y="20" width="24" height="24" fill="#16A368" />
          </svg>
          <span>Zenkai</span>
        </a>

        <div class="v3-nav-links">
          <a href="#grid">Grid</a>
          <a href="#providers">Providers</a>
          <a href="#download">Download</a>
          <a href="/v2" style="opacity:0.65;font-family:var(--font-mono);font-size:0.74rem;">v2 ↗</a>
        </div>

        <div class="v3-nav-actions">
          <a
            class="icon-link"
            href="https://github.com/EmilioGiordano/Zenkai"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Zenkai on GitHub"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>

          <button
            class="theme-toggle"
            id="v3-theme-toggle"
            type="button"
            aria-label="Toggle Light and Dark theme"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <span class="label-light">Alpine Day</span>
            <span class="label-dark">Starlight</span>
          </button>

          <a class="btn btn-primary btn-sm" href="#download">Download</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <Hero />
      <VirtualGridSection />
      <ProvidersSection />
      <DownloadSection />
    </main>

    <Footer />
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('v3-theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('zenkai-natural-theme', next);
        } catch (e) {}
      });
    })();
  </script>
</BaseLayout>
